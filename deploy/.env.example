# DocuShelf – Konfiguration für docker compose
#
# Kopieren nach .env (liegt neben compose.yaml) und anpassen:  cp .env.example .env
#
# Hinweise zum Format
# - Leere Werte bedeuten „Standard“. Auskommentierte Zeilen zeigen den Standardwert.
# - Werte mit $ (Passwort-Hashes, manche Passwörter) in einfache Anführungszeichen
#   setzen: NAME='wert$mit$dollar' – sonst ersetzt Compose $… durch Variablen.
# - Geheimnisse können statt im Klartext als Datei übergeben werden: an den
#   Variablennamen _FILE anhängen und den Pfad im Container angeben, z. B.
#   DOCUSHELF_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# - Nicht geheime Einstellungen können auch in <daten>/config/settings.yaml stehen
#   (kleingeschrieben, ohne Präfix, z. B. „ocr_jobs: 4“). Umgebungsvariablen gewinnen.


# =============================================================================
# Stack (nur für docker compose, nicht für die App)
# =============================================================================

# Image der App. Standard: lokal aus dem Repository gebaut (docker compose build).
# DOCUSHELF_IMAGE=docushelf:local
# DOCUSHELF_FTP_IMAGE=docushelf-ftp:local

# Datenverzeichnis auf dem Host (archiv/, eingang/, config/, protokoll/, index/ …).
# Am besten ein absoluter Pfad. Muss für DOCUSHELF_UID beschreibbar sein.
DOCUSHELF_DATA_PATH=./data

# Benutzer und Gruppe, unter denen DocuShelf läuft (Besitzer aller Dateien).
# DOCUSHELF_UID=1000
# DOCUSHELF_GID=1000

# Weboberfläche auf dem Host: Adresse und Port für einen Reverse Proxy auf dem
# Host. Mit Traefik im Docker-Netz bleibt das ungenutzt.
# DOCUSHELF_HTTP_BIND=127.0.0.1
# DOCUSHELF_HTTP_PORT=8000

# Private Adresse des Servers (VPN, z. B. Tailscale), auf der SMB (445) und FTP
# (21 + passive Ports) erreichbar sind – erst setzen, wenn diese Kanäle genutzt
# werden. Niemals eine öffentliche Adresse. Leer: nur 127.0.0.1.
# DOCUSHELF_PRIVATE_IP=100.64.0.10
# Der SMTP-Empfänger (Port 2525) hat eine eigene Adresse, siehe DOCUSHELF_SMTP_BIND
# im Abschnitt „SMTP-Empfänger“ – so hängt die App selbst nicht vom VPN ab.


# =============================================================================
# Grundeinstellungen
# =============================================================================

# Adresse, unter der DocuShelf im Browser erreichbar ist (für Links und SSO).
# Mit https:// werden Sitzungs-Cookies nur über HTTPS gesendet.
DOCUSHELF_BASE_URL=https://docs.example.net

# Zeitzone für Datumsangaben und Protokolle (Standard: TZ, sonst Europe/Berlin).
DOCUSHELF_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin

# Protokoll-Ausführlichkeit: debug, info, warning, error
# DOCUSHELF_LOG_LEVEL=info

# Datenverzeichnis im Container – setzt compose.yaml fest auf /data.
# DOCUSHELF_DATA_DIR=/data

# Archivordner, falls er nicht unter <daten>/archiv liegt (eigener Mount, z. B.
# eine NAS-Freigabe; in compose.yaml zusätzlich einbinden). Fehlt der Ordner beim
# Start, startet DocuShelf nicht – ein leeres Archiv wird nie mit dem echten
# verwechselt.
# DOCUSHELF_ARCHIVE_DIR=/archiv

# Adresse und Port im Container – setzt compose.yaml fest (0.0.0.0:8000).
# DOCUSHELF_HOST=0.0.0.0
# DOCUSHELF_PORT=8000

# Name des Haushalts (Einstellungen, Umschalter) – nur ohne config/households.yaml;
# mit mehreren Haushalten steht der Name je Haushalt in dieser Datei
# (Vorlage: households.example.yaml, Anleitung: DEPLOY.md, Abschnitt 13).
# DOCUSHELF_HOUSEHOLD_NAME=Zuhause
# Mit mehreren Haushalten: Konten (Benutzername oder E-Mail, kommagetrennt), die in
# Einstellungen → Haushalte die Mitglieder pflegen dürfen – zusätzlich zu „admins:“
# in households.yaml und dem Notfallzugang.
# DOCUSHELF_ADMIN_USERS=erika@example.org
# Dasselbe für OIDC-Gruppen: Alle Mitglieder dieser Gruppen (kommagetrennt) sind Admins,
# zusätzlich zu „admin_groups:“ in households.yaml.
# DOCUSHELF_ADMIN_GROUPS=software-admins
# Admins verwalten außerdem Einstellungen → Eingangskanäle (auch mit nur einem Haushalt).

# Schlüssel für Sitzungs-Cookies. Leer: wird beim ersten Start erzeugt und in
# config/secret.key gespeichert (empfohlen). Ein neuer Schlüssel meldet alle ab.
# DOCUSHELF_SECRET_KEY=
# DOCUSHELF_SECRET_KEY_FILE=/run/secrets/docushelf_secret

# Reverse Proxys, deren X-Forwarded-*-Header gelten: IP-Adressen oder Netze,
# kommagetrennt. Standard: Loopback und private Netze (deckt Docker-Netze ab).
# „*“ vertraut jedem Absender – nur sinnvoll, wenn der Port allein für den Proxy
# erreichbar ist.
# DOCUSHELF_TRUSTED_PROXIES=172.16.0.0/12

# Sitzungs-Cookies nur über HTTPS (Standard: automatisch nach DOCUSHELF_BASE_URL).
# DOCUSHELF_SECURE_COOKIES=

# Wie lange eine Anmeldung gilt, in Sekunden (Standard: 14 Tage). Geänderte
# Gruppen im Anmeldedienst wirken erst bei der nächsten Anmeldung – wer das
# schneller will, nimmt 1–2 Tage (z. B. 172800). Alle abmelden: neuen
# DOCUSHELF_SECRET_KEY setzen bzw. config/secret.key löschen und neu starten.
# DOCUSHELF_SESSION_MAX_AGE=1209600

# Hintergrunddienste (Verarbeitung, Eingangskanäle, Abgleich) starten.
# Nur für Tests ausschalten.
# DOCUSHELF_START_BACKGROUND=true


# =============================================================================
# Anmeldung per SSO (OIDC, z. B. Authentik) – siehe DEPLOY.md
# =============================================================================

# Issuer-URL des Providers. Authentik: https://<authentik>/application/o/<slug>/
DOCUSHELF_OIDC_ISSUER=https://auth.example.net/application/o/docushelf/
DOCUSHELF_OIDC_CLIENT_ID=
DOCUSHELF_OIDC_CLIENT_SECRET=
# DOCUSHELF_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret

# Beschriftung des Anmeldeknopfs
# DOCUSHELF_OIDC_LABEL="Mit SSO anmelden"

# Angefragte Scopes; „profile“ liefert bei Authentik auch die Gruppen.
# DOCUSHELF_OIDC_SCOPES="openid email profile"

# Wer sich anmelden darf. (Mit config/households.yaml gelten stattdessen die Gruppen und
# Konten der einzelnen Haushalte; die Angaben hier werden dann nicht verwendet.)
# Am sichersten über eine Gruppe aus dem Claim „groups“,
# deren Mitglieder nur der Admin des Anmeldedienstes festlegt – zusätzlich die
# Anwendung im Anmeldedienst an dieselbe Gruppe binden (DEPLOY.md, Abschnitt 4).
DOCUSHELF_ALLOWED_GROUPS=docushelf-users
# Einzelne Konten (kommagetrennt) vergleicht DocuShelf mit dem Benutzernamen beim
# Anmeldedienst (preferred_username) und der bestätigten E-Mail-Adresse. Das ist
# nur sicher, solange niemand seinen Benutzernamen selbst wählen oder ändern kann
# (bei Authentik der Standard) – sonst besser nur Gruppen verwenden.
# DOCUSHELF_ALLOWED_USERS=alex,sam
# Beides leer: niemand – außer mit DOCUSHELF_ALLOW_ALL_OIDC_USERS=true.
# DOCUSHELF_ALLOW_ALL_OIDC_USERS=false


# =============================================================================
# Lokaler Notfallzugang (wenn SSO nicht erreichbar ist)
# =============================================================================

# Benutzername des Notfallzugangs (auch Standardbenutzer für API-Tokens aus der CLI)
# DOCUSHELF_ADMIN_USER=admin

# Passwort-Hash, erzeugen mit:
#   docker compose run --rm docushelf docushelf hash-password --env
# Einfache Anführungszeichen sind wegen der $-Zeichen nötig. Ein neuer Hash
# beendet alle Sitzungen des Notfallzugangs.
# DOCUSHELF_ADMIN_PASSWORD_HASH='scrypt$32768$8$1$...$...'
# DOCUSHELF_ADMIN_PASSWORD_HASH_FILE=/run/secrets/docushelf_admin_hash

# Passwort im Klartext – nur zum Ausprobieren, sonst den Hash verwenden.
# DOCUSHELF_ADMIN_PASSWORD=


# =============================================================================
# Verarbeitung und Texterkennung
# =============================================================================

# Texterkennung (OCRmyPDF/Tesseract). Dokumente mit Textebene werden nicht erneut erkannt.
# DOCUSHELF_OCR_ENABLED=true
# Sprachen (Tesseract-Kürzel, mit + verbunden). Im Image enthalten: deu, eng.
# DOCUSHELF_OCR_LANGUAGES=deu+eng
# CPU-Kerne je OCR-Lauf
# DOCUSHELF_OCR_JOBS=2
# Zeitlimit je Dokument in Sekunden
# DOCUSHELF_OCR_TIMEOUT=900
# Ausgabeformat: pdfa-2 (Archivformat), pdfa-1, pdfa-3, pdf
# DOCUSHELF_OCR_OUTPUT_TYPE=pdfa-2
# Zusätzliche Argumente für ocrmypdf, kommagetrennt, z. B. --clean
# DOCUSHELF_OCR_EXTRA_ARGS=

# Leere Seiten (Rückseiten von Duplex-Scans) entfernen
# DOCUSHELF_BLANK_PAGE_REMOVAL=true
# Anteil dunkler Bildpunkte, unter dem eine Seite als leer gilt
# DOCUSHELF_BLANK_PAGE_THRESHOLD=0.004

# Dokumente, die gleichzeitig verarbeitet werden
# DOCUSHELF_WORKER_THREADS=1
# OCR-Läufe, die im ganzen Prozess gleichzeitig laufen dürfen (Standard 1). Mit mehreren
# Haushalten teilen sie sich diese Plätze, damit der Server nicht überlastet wird.
# DOCUSHELF_OCR_PARALLEL=1
# Größte Datei beim Hochladen im Browser, in MB
# DOCUSHELF_MAX_UPLOAD_MB=200


# =============================================================================
# Eingangskanäle (Ordner unter eingang/quellen/)
# =============================================================================

# Sekunden, die eine Datei unverändert sein muss, bevor sie übernommen wird
# (Upload- und Watch-Ordner bzw. Netzwerk-Kanäle SMB/FTP, die in Etappen schreiben)
# DOCUSHELF_STABLE_SECONDS=5
# DOCUSHELF_REMOTE_STABLE_SECONDS=10

# Eingangsordner von SMB (eingang/quellen/smb) und FTP (eingang/quellen/ftp)
# überwachen. Standard: an. Ausschalten mit DOCUSHELF_SOURCE_SMB=false bzw.
# DOCUSHELF_SOURCE_FTP=false (DOCUSHELF_SMB_ENABLED/_FTP_ENABLED=true erzwingen sie).
# DOCUSHELF_SOURCE_SMB=true
# DOCUSHELF_SOURCE_FTP=true
# DOCUSHELF_SMB_ENABLED=false
# DOCUSHELF_FTP_ENABLED=false

# Weitere überwachte Ordner im Container: name=/pfad, kommagetrennt. Ordner in
# compose.yaml einbinden. Dateien werden nach der Übernahme entfernt.
# DOCUSHELF_WATCH_FOLDERS=scanner=/watch/scanner
# Mit mehreren Haushalten gelten diese Ordner und die IMAP-/SMTP-Einstellungen unten nur für
# den Haushalt mit path "."; die anderen tragen ihre eigenen in households.yaml ein.
# Alle Kanäle lassen sich auch in der Oberfläche einstellen (Einstellungen → Eingangskanäle).
# Sobald ein Haushalt dort gespeichert hat (config/channels.yaml), gelten für ihn nur noch
# diese Datei: Watch-Ordner, IMAP und SMTP-Adressen von hier sind dann nur noch Voreinstellung.


# =============================================================================
# Mail-Abruf per IMAP (Rechnungen weiterleiten, Scan-to-Mail über einen Mailanbieter)
# =============================================================================

# DOCUSHELF_IMAP_ENABLED=false
# DOCUSHELF_IMAP_HOST=imap.example.net
# DOCUSHELF_IMAP_PORT=993
# DOCUSHELF_IMAP_SSL=true
# DOCUSHELF_IMAP_USER=dokumente@example.net
# DOCUSHELF_IMAP_PASSWORD=
# DOCUSHELF_IMAP_PASSWORD_FILE=/run/secrets/imap_password
# Postfachordner, der abgerufen wird
# DOCUSHELF_IMAP_FOLDER=INBOX
# Verarbeitete Mails werden verschoben, nie gelöscht:
# DOCUSHELF_IMAP_PROCESSED_FOLDER=DocuShelf/Verarbeitet
# DOCUSHELF_IMAP_REJECTED_FOLDER=DocuShelf/Abgelehnt
# DOCUSHELF_IMAP_NO_ATTACHMENT_FOLDER="DocuShelf/Ohne Anhang"
# Erlaubte Absender: Adressen oder @domain, kommagetrennt. Leer: keiner; * : alle.
# DOCUSHELF_IMAP_ALLOWED_SENDERS=alex@example.net,sam@example.net
# Abrufintervall in Sekunden
# DOCUSHELF_IMAP_POLL_SECONDS=60


# =============================================================================
# SMTP-Empfänger für Scan-to-Mail direkt vom Drucker (Port 2525, nur VPN)
# =============================================================================

# DOCUSHELF_SMTP_ENABLED=false
# Adresse auf dem Host, auf der Port 2525 veröffentlicht wird: die VPN-Adresse
# des Servers, sobald der SMTP-Empfang genutzt wird. Leer: nur 127.0.0.1.
# DOCUSHELF_SMTP_BIND=100.64.0.10
# Einzige Empfängeradresse, die angenommen wird (kein Relay). Mit mehreren Haushalten
# stehen die Adressen je Haushalt in households.yaml (smtp_recipients); diese hier
# gehört dann zum Haushalt mit path ".".
# DOCUSHELF_SMTP_RECIPIENT=scan@docs.example.net
# Absender-Netze (IP oder CIDR, kommagetrennt). Leer: niemand. Die Drucker-IP
# eintragen, z. B. 192.168.1.20/32
# DOCUSHELF_SMTP_ALLOWED_NETWORKS=
# Größte Mail in MB
# DOCUSHELF_SMTP_MAX_MESSAGE_MB=50
# Optional Anmeldung (AUTH PLAIN/LOGIN), falls der Drucker das verlangt
# DOCUSHELF_SMTP_USER=
# DOCUSHELF_SMTP_PASSWORD=
# Adresse und Port im Container – setzt compose.yaml fest (0.0.0.0:2525).
# DOCUSHELF_SMTP_HOST=0.0.0.0
# DOCUSHELF_SMTP_PORT=2525


# =============================================================================
# Ablagevorschläge
# =============================================================================

# Vorschläge aus der Ähnlichkeit zu bereits abgelegten Dokumenten
# DOCUSHELF_SIMILARITY_ENABLED=true

# Namen der Personen, denen das Archiv gehört (kommagetrennt). Sie werden nie als
# Absender eines Dokuments vorgeschlagen, auch wenn sie im Adressfeld stehen.
# Empfohlen: ohne diese Angabe wird der eigene Name auf Briefen ohne „Herrn/Frau“
# leicht für den Absender gehalten.
# DOCUSHELF_OWNER_NAMES=Erika Mustermann, Max Mustermann

# Sprachmodell (KI) für Ordner, Titel und Datum – optional, siehe DEPLOY.md Abschnitt 7.
# Der Text jedes Dokuments geht an die Adresse in DOCUSHELF_LLM_URL. Mit dem Standard
# (Ollama auf dem eigenen Server, z. B. als Container „ollama“ neben DocuShelf) verlässt
# nichts das Haus. Ein Dienst im Internet würde jedes Dokument mitlesen – wenn Dokumente
# das Haus nicht verlassen dürfen, nur einen lokalen Server eintragen.
# DOCUSHELF_LLM_ENABLED=false
# Art des Servers: ollama (Standard) oder openai – jeder Server mit OpenAI-kompatibler
# Chat-Schnittstelle (llama.cpp-Server, vLLM, LocalAI, LM Studio …) oder anthropic
# (Anthropic-API im Internet; braucht DOCUSHELF_LLM_API_KEY, keine URL, Standardmodell
# claude-opus-5-5 – jedes Dokument wird dann an Anthropic geschickt)
# DOCUSHELF_LLM_PROVIDER=ollama
# Adresse des Servers. Bei openai mit oder ohne /v1 am Ende (z. B. http://llama:8080/v1);
# dort gibt es keinen Standard.
# DOCUSHELF_LLM_URL=http://ollama:11434
# Modellname (Ollama: vorher laden, z. B. „ollama pull qwen2.5:7b“)
# DOCUSHELF_LLM_MODEL=qwen2.5:7b
# API-Schlüssel, falls der Server einen verlangt (als Bearer-Token, wird nie angezeigt)
# DOCUSHELF_LLM_API_KEY=
# DOCUSHELF_LLM_API_KEY_FILE=/run/secrets/llm_api_key
# Zeitlimit je Anfrage in Sekunden (auf einer CPU braucht ein 7B-Modell gern 1–3 Minuten)
# DOCUSHELF_LLM_TIMEOUT=180
# Höchstens übergebene Textlänge: der Anfang des Dokuments, dazu die letzten 1000 Zeichen
# DOCUSHELF_LLM_MAX_CHARS=6000
# Kontextgröße in Tokens (Ollama „num_ctx“, mindestens 1024). Ollamas eigener Standard ist
# zu klein für Ordnerliste und Dokument und schneidet stillschweigend ab.
# DOCUSHELF_LLM_CONTEXT=8192


# =============================================================================
# Automatische Ablage – siehe DEPLOY.md Abschnitt 7
# =============================================================================

# Was ohne Rückfrage abgelegt wird (Groß-/Kleinschreibung egal):
#   off       / aus     nichts, alles wartet im Eingang auf dich (Standard)
#   rules     / regeln  nur Dokumente, auf die eine Regel mit „auto: true“ passt
#   confident / sicher  zusätzlich alles, was mindestens so sicher ist wie die Schwelle;
#                       der Rest bleibt im Eingang
#   always    / immer   alles; was unter der Schwelle liegt, wird als „unsicher“ markiert
# Jede automatische Ablage steht im Audit-Protokoll und in der Oberfläche unter
# Eingang → Automatisch abgelegt, dort lässt sie sich bestätigen oder korrigieren.
# DOCUSHELF_AUTO_FILE=off
# Schwelle für „sicher“, zwischen 0 und 1 (0.75 = 75 %)
# DOCUSHELF_AUTO_FILE_THRESHOLD=0.75
# Eingänge, deren Dokumente automatisch abgelegt werden dürfen, kommagetrennt; ein * am
# Ende passt auf alle Namen mit diesem Anfang. paperless (Import) und unbekannt zählen
# nur, wenn sie ausdrücklich genannt sind.
# DOCUSHELF_AUTO_FILE_SOURCES=upload,smb,ftp,mail,smtp,watch-*
# Darf die automatische Ablage neue Ordner anlegen?
# DOCUSHELF_AUTO_FILE_NEW_FOLDERS=true
# Mit Sprachmodell: erst nach dessen Antwort (oder Fehler) entscheiden
# DOCUSHELF_AUTO_FILE_WAIT_FOR_LLM=true
# Eine Benachrichtigung je automatisch abgelegtem Dokument (nur mit DOCUSHELF_NOTIFY_URL)
# DOCUSHELF_AUTO_FILE_NOTIFY=true


# =============================================================================
# Wartung
# =============================================================================

# Vollständiger Abgleich von Archiv und Index alle … Sekunden (zusätzlich zum
# Dateisystem-Watcher; Standard 6 Stunden)
# DOCUSHELF_RECONCILE_INTERVAL=21600
# Tage, die gelöschte Dokumente im Papierkorb bleiben
# DOCUSHELF_TRASH_RETENTION_DAYS=30
# Tage, die Originale abgelegter Dokumente in eingang/erledigt bleiben
# DOCUSHELF_KEEP_ORIGINALS_DAYS=30
# Benachrichtigung, wenn etwas im Fehlerbereich landet und für jede automatische Ablage
# (ntfy-Topic oder Webhook)
# DOCUSHELF_NOTIFY_URL=https://ntfy.example.net/docushelf


# =============================================================================
# Samba (Profil „smb“) – Konten in samba.env, siehe samba.env.example
# =============================================================================

# Erlaubte Quell-Adressen (Leerzeichen-getrennt): Drucker-IP und VPN-Netz.
# Leer: niemand außer 127.0.0.1.
SAMBA_HOSTS_ALLOW="192.168.1.20 100.64.0.0/10"
# Konten mit Zugriff auf die Freigabe „archiv“ (Leerzeichen-getrennt)
SAMBA_ARCHIVE_USERS="alex sam"
# Rechte des SMB-Eingangsordners: 1733 = Drucker kann nur schreiben, nicht auflisten.
# Nur falls ein Drucker unbedingt auflisten muss: 2770 (dann sieht er seine
# eigenen, noch nicht abgeholten Scans).
# SAMBA_SCAN_DIR_MODE=1733


# =============================================================================
# FTP (Profil „ftp“)
# =============================================================================

# FTP_USER=scanner
FTP_PASSWORD='bitte-ein-langes-zufaelliges-passwort'
# Passiver Portbereich (in der VPN-ACL freigeben)
# FTP_PASV_MIN_PORT=30000
# FTP_PASV_MAX_PORT=30009
# Verzeichnislisten leer lassen (nur Hochladen). „no“, falls ein Drucker nach dem
# Hochladen per Auflistung prüft, ob die Datei angekommen ist.
# FTP_HIDE_FILES=yes
# Nur mit TLS (FTPS) – braucht tls.crt/tls.key in ./certs
# FTP_TLS_REQUIRED=no


# =============================================================================
# iPhone/iPad: Kurzbefehl „DocuShelf senden“ (Einstellungen → Handy & Tablet)
# =============================================================================

# Statt einer signierten Datei in config/shortcuts/DocuShelf senden.shortcut ein
# iCloud-Link des Kurzbefehls (nur https). Die Datei hat Vorrang. Anleitung: contrib/ios/README.md
# DOCUSHELF_IOS_SHORTCUT_URL=https://www.icloud.com/shortcuts/…
