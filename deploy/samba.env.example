# Samba-Konten für das Profil „smb“
#
# Kopieren nach samba.env und Passwörter setzen:  cp samba.env.example samba.env
# Zufällige Passwörter z. B. mit:  openssl rand -base64 24
# Passwörter in einfache Anführungszeichen setzen (sonst ersetzt Compose $…).
#
# Format des Samba-Images: ACCOUNT_<name>=<passwort>, UID_<name>=<uid>
# Kontonamen klein schreiben.

# Drucker – darf nur in die Freigabe „scan“ schreiben. Eigene UID (nicht die
# von DocuShelf!), sonst wäre der Briefkasten für ihn lesbar.
ACCOUNT_scanner='bitte-ein-langes-zufaelliges-passwort'
UID_scanner=1001

# Dienstkonto, dem alle Dateien der Freigabe „archiv“ gehören. Die UID setzt
# compose.yaml (= DOCUSHELF_UID). Niemand meldet sich damit an; trotzdem ein
# langes Zufallspasswort setzen.
ACCOUNT_docushelf='bitte-ein-anderes-zufaelliges-passwort'

# Haushalt – Zugriff auf die Freigabe „archiv“. Namen zusätzlich in der .env
# unter SAMBA_ARCHIVE_USERS eintragen. UIDs frei wählbar, aber eindeutig.
ACCOUNT_alex='passwort-fuer-alex'
UID_alex=1101
ACCOUNT_sam='passwort-fuer-sam'
UID_sam=1102
